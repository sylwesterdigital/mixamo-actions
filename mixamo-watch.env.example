# Copy to ./mixamo-watch.env (not committed). SSH keys and Git identity are managed by macOS.
MIXAMO_AUTO_GIT_PUSH=1
MIXAMO_AUTO_DEPLOY=1
MIXAMO_DEPLOY_TARGET=root@yolo.cx
MIXAMO_DEPLOY_PORT=18021
MIXAMO_POLL_SECONDS=5
MIXAMO_ALLOW_DIRTY_CORE=0

# Optional: custom SSH push URL (otherwise https://github.com/... origin is converted automatically)
# MIXAMO_GIT_PUSH_URL=git@github.com:sylwesterdigital/mixamo-actions.git
